# Copy this file to .env in the repo root and fill in your key:
#   cp .env.example .env
# .env is gitignored - never commit real keys.

# Stage 2 - insight extraction (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Stage 3 - priority assessment (any OpenAI-compatible endpoint)
# Pointed at OpenRouter by default, reusing the key above.
PROMPT2_API_URL=https://openrouter.ai/api/v1/chat/completions
PROMPT2_API_KEY=${OPENROUTER_API_KEY}
PROMPT2_MODEL=deepseek/deepseek-v4-flash-0731
