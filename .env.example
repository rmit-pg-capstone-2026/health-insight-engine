# Copy this file to .env in the repo root for local development:
#   cp .env.example .env
# .env is gitignored - never commit real credentials.

# ---------------------------------------------------------------------------
# LLM backend used by BOTH AI stages: extract + priority assessment.
#   bedrock  = AWS credential chain / Lambda execution role + SigV4
#   api_key  = bearer-key OpenAI-compatible endpoint (for example OpenRouter)
# ---------------------------------------------------------------------------
LLM_BACKEND=bedrock

# ------------------------------- Bedrock / IAM (recommended AWS deployment)
AWS_REGION=ap-southeast-2

EXTRACT_API_URL=https://bedrock-runtime.ap-southeast-2.amazonaws.com/openai/v1/chat/completions
EXTRACT_MODEL=moonshotai.kimi-k2.5

PROMPT2_API_URL=https://bedrock-runtime.ap-southeast-2.amazonaws.com/openai/v1/chat/completions
PROMPT2_MODEL=moonshotai.kimi-k2.5

# No LLM API keys are required in bedrock mode. Locally use the normal AWS
# credential chain/SSO; in Lambda use the function execution role.

# -------------------------------- API-key fallback / development alternative
# Set LLM_BACKEND=api_key and uncomment/configure these values.
# OPENROUTER_API_KEY=sk-or-v1-replace-me
# EXTRACT_API_URL=https://openrouter.ai/api/v1/chat/completions
# EXTRACT_API_KEY=${OPENROUTER_API_KEY}
# EXTRACT_MODEL=deepseek/deepseek-v4-flash-0731
# EXTRACT_PROVIDER=deepinfra
# PROMPT2_API_URL=https://openrouter.ai/api/v1/chat/completions
# PROMPT2_API_KEY=${OPENROUTER_API_KEY}
# PROMPT2_MODEL=deepseek/deepseek-v4-flash-0731

# Automated pipeline (pipeline/run.py)
# PIPELINE_DATA_DIR=data             # pipeline.db, markdown versions and PDFs
# PIPELINE_S3_BUCKET=                # required by pipeline/lambda_handler.py
