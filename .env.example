# Copy this file to .env in the repo root for local development:
#   cp .env.example .env
# .env is gitignored - never commit real credentials.

# ---------------------------------------------------------------------------
# Bedrock Converse is the default for both automated AI stages.
# Set LLM_BACKEND=api_key only for the explicit development/recovery path.
# ---------------------------------------------------------------------------
LLM_BACKEND=bedrock

# ------------------------------- Bedrock / IAM (recommended AWS deployment)
AWS_REGION=ap-southeast-2

EXTRACT_MODEL=moonshotai.kimi-k2.5
EXTRACT_REASONING=off

PRIORITY_ASSESSMENT_MODEL=au.anthropic.claude-opus-4-6-v1
PRIORITY_ASSESSMENT_REASONING=off
PRIORITY_ASSESSMENT_TEMPERATURE=0.0

# No LLM API keys are required in bedrock mode. Locally use the normal AWS
# credential chain/SSO; in Lambda use the function execution role.

# -------------------------------- API-key fallback / development alternative
# Set LLM_BACKEND=api_key and uncomment/configure these values.
# OPENROUTER_API_KEY=sk-or-v1-replace-me
# EXTRACT_API_URL=https://openrouter.ai/api/v1/chat/completions
# EXTRACT_API_KEY=${OPENROUTER_API_KEY}
# EXTRACT_MODEL=deepseek/deepseek-v4-flash-0731
# EXTRACT_PROVIDER=deepinfra
# PRIORITY_ASSESSMENT_API_URL=https://openrouter.ai/api/v1/chat/completions
# PRIORITY_ASSESSMENT_API_KEY=${OPENROUTER_API_KEY}
# PRIORITY_ASSESSMENT_MODEL=deepseek/deepseek-v4-flash-0731

# ------------------------------------------------ Executive summary (briefing)
# The briefing's Executive Summary uses the same LLM_BACKEND. These are
# optional: when unset, the PRIORITY_ASSESSMENT_* values above are used.
# EXEC_SUMMARY_MODEL=                # e.g. au.anthropic.claude-opus-4-6-v1
# EXEC_SUMMARY_REASONING=off
# EXEC_SUMMARY_API_URL=              # api_key mode only
# EXEC_SUMMARY_API_KEY=              # api_key mode only
# EXEC_SUMMARY_MODE=llm              # llm (default) | rules (no LLM) | none

# Emailing the briefing PDF via Amazon SES (optional; both needed to send).
# While SES is in the sandbox, every address must be a verified identity.
# BRIEFING_SENDER=you@example.com
# BRIEFING_RECIPIENTS=a@example.com, b@example.com

# Automated pipeline (pipeline/run.py)
# PIPELINE_DATA_DIR=data             # pipeline.db, markdown versions and PDFs
# PIPELINE_S3_BUCKET=                # required by pipeline/lambda_handler.py
